# Copy to .env and replace the dummy values; .env is gitignored (CLAUDE.md rule 5).
# Read by docker-compose.yml and by backend/app/config.py (pydantic-settings).

# PostgreSQL container (docker-compose.yml).
POSTGRES_USER=lapzero
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lapzero
# Host port of the container; use another (e.g. 5433) if a local PostgreSQL already has 5432,
# and change DATABASE_URL to match.
POSTGRES_PORT=5432

# Backend (backend/app/config.py).
# SQLAlchemy URL of the database; the integration tests create throwaway databases on its server.
DATABASE_URL=postgresql+psycopg://lapzero:change-me@localhost:5432/lapzero
# MLflow tracking URI with the model registry. Default: the file store at <repo>/mlruns.
# MLFLOW_TRACKING_URI=http://localhost:5000
# Registered model whose champion GET /api/models/champion reports.
MLFLOW_MODEL_NAME=lapzero-policy
# Browser origins allowed to call the API, as a JSON list.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# development, test or production.
ENVIRONMENT=development
# Where uploaded lap telemetry is stored as <track_id>/<lap_id>.json. Default: <repo>/data/laps.
# LAPS_DIR=/srv/lapzero/data/laps
# Where each track's <track_id>/centreline.csv is read from. Default: <repo>/tracks.
# TRACKS_DIR=/srv/lapzero/tracks
